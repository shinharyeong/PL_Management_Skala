# 복사해서 ai/.env 로 사용하세요. 값이 비어 있으면 기본값을 씁니다. 실제 키는 절대 커밋하지 마세요.
# 우선순위: ai/.env > 셸 환경변수 > 기본값

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_DAILY_CALL_LIMIT=30
# 선택: 임시 한도의 마지막 적용일(한국 시간, YYYY-MM-DD). 비우면 만료 없이 기존 한도를 사용한다.
AI_DAILY_CALL_LIMIT_EXPIRES_ON=
# 만료일 다음 날부터 적용할 한도. 미설정 시 기본값 30이며 .env 값을 자동 수정하지 않는다.
AI_DAILY_CALL_LIMIT_AFTER_EXPIRY=30
# 아래 경로는 메모리 캐시·사용량 격리 키로만 쓰며 폴더를 만들지 않음
AI_CACHE_DIR=ai/.cache

# 이전 호출부 호환용 집계 그룹(폴더 생성·결과 저장 없음)
OUTPUT_DIR=ai/output

# 챗봇(AI 작업실)·값 채우기 — 조회 DB(PostgreSQL). 읽기는 읽기 전용 연결로만 한다. 조회 전용 계정을 쓰는 것을 권한다(README_AI_REPORT.md)
# 예: postgresql://사용자:비밀번호@127.0.0.1:15432/데이터베이스   (비우면 챗봇·값 채우기는 'DB 없음'으로 답한다)
AI_DATABASE_URL=
AI_DB_SCHEMA=report
CHAT_ROW_LIMIT=1000
CHAT_SQL_TIMEOUT_SECONDS=20
CHAT_MAX_FIX=2
CHAT_MEMORY=true       # 대화 기억(서버 메모리에만 보관, 최근 6턴·2시간, 재시작하면 사라짐). false 면 이전 대화를 쓰지 않음
CHAT_TEST_LOG=0        # 1 이면 질문마다 비용 측정 지표를 stdout 로 남김(질문 원문·키 없음)
# 보고 작성 전용 내부 인증. 백엔드의 REPORT_AI_TOKEN과 같은 값을 별도 설정한다.
REPORT_AI_TOKEN=
# PDF 분석 결과를 보고할 backend 주소(/internal/pdf-jobs/{id}/result). 예: http://backend:8080
AI_BACKEND_URL=
# true(운영)면 REPORT_AI_TOKEN 이 없을 때 계약 API 거부·결과 보고 안 함. 로컬 개발은 false
AI_REQUIRE_INTERNAL_TOKEN=false
# 백엔드에는 REPORT_AI_URL=http://127.0.0.1:8000도 설정한다.
