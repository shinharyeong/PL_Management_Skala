# 복사해서 ai/.env 로 사용하세요. 값이 비어 있으면 기본값을 씁니다. 실제 키는 절대 커밋하지 마세요.
# 우선순위: ai/.env > 셸 환경변수 > 기본값

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_DAILY_CALL_LIMIT=30
AI_CACHE_DIR=ai/.cache

# 결과 폴더(상대 경로는 저장소 루트 기준)
OUTPUT_DIR=ai/output

# 파이프라인(배치) 입력 — 업로드된 파일을 가리키는 경로. 비워 두면 파이프라인 실행 시 설정 오류로 안내합니다.
INPUT_DIR=
EXPLANATIONS_PATH=
APPROVALS_PATH=
SCENARIO_DIR=
SCENARIO_CSV_PATH=

# 업로드 실행(POST /v1/pipeline/run) — 업로드 파일은 AI_CACHE_DIR/uploads/<run_id>/ 에 저장, 결과는 AI_CACHE_DIR/runs/<run_id>/
AI_UPLOAD_MAX_FILES=150
AI_UPLOAD_MAX_FILE_MB=30
AI_UPLOAD_MAX_TOTAL_MB=400
AI_UPLOAD_KEEP=true
AI_PARSE_WORKERS=0   # 엑셀 파싱 동시 프로세스 수(0=자동). 파일 내용이 같으면 AI_CACHE_DIR/parse_cache 의 이전 결과를 다시 씁니다

# 챗봇(AI 작업실) — 조회 DB(SQLite, 읽기 전용으로 연결). 비우면 AI_CACHE_DIR/chat/chat.db
CHAT_DB_PATH=
CHAT_ROW_LIMIT=1000
CHAT_SQL_TIMEOUT_SECONDS=20
CHAT_MAX_FIX=2
CHAT_MEMORY=true       # 대화 기억(서버 메모리에만 보관, 최근 6턴·2시간, 재시작하면 사라짐). false 면 이전 대화를 쓰지 않음
CHAT_TEST_LOG=0        # 1 이면 질문마다 비용 측정 한 줄을 AI_CACHE_DIR/chat/test_log.jsonl 에 남김(질문 원문·키 없음)
# 보고 작성 전용 내부 인증. 백엔드의 REPORT_AI_TOKEN과 같은 값을 별도 설정한다.
REPORT_AI_TOKEN=
# 백엔드에는 REPORT_AI_URL=http://127.0.0.1:8000도 설정한다.
