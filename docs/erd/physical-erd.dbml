// 경영팀을 부탁해 · 물리 ERD (PostgreSQL)
// 2026-11-23 기준: PRD · 와이어프레임(경영기획팀·조직 담당자 v3·AI 보고서 v1) · 인프라 문서를 반영한 설계안.
//   [PRD] submission.reply_message·approved_seq, review_item.rejected, gap_threshold.comparison(3종), parsing_job NEEDS_REVIEW 제거,
//         보고서 틀·지표 사전·소명 분류표·소명 분류 테이블 추가 (보고서 결과물은 DB에 저장하지 않음)
//   [아키텍처] stored_object 바이트 → S3 키 메타데이터, pdf_job 추가, notification_read → notification
//   [팀 결정] annual_plan.contingency_amount 삭제
//   [운영] parsing_job.created_at, 기준 데이터 created_at·updated_at(account_item은 created_at만),
//         review_item.created_at·updated_at, annual_plan.created_at, report_template.updated_at
//   바뀐 컬럼·테이블에는 note에 근거를 적었다(dbdiagram에서 마우스를 올리면 보임).
// dbdiagram.io 왼쪽 편집창에 전부 붙여 넣으면 된다.

Table "organization" {
  "id" bigint [not null, increment]
  "code" varchar(80) [not null]
  "name" varchar(200) [not null]
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 생성 시각']
  "updated_at" timestamptz [not null, default: `now()`, note: '추가: 마지막 수정 시각']

  Indexes {
    id [pk, name: "organization_pkey"]
    code [unique, name: "organization_code_key"]
  }
}

Table "app_user" {
  "id" bigint [not null, increment]
  "email" varchar(320) [not null]
  "name" varchar(200) [not null]
  "role" "varchar(30) · PLANNER / ORG_MANAGER" [not null]
  "organization_id" bigint
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 생성 시각']
  "updated_at" timestamptz [not null, default: `now()`, note: '추가: 마지막 수정 시각']

  Checks {
    `(((role = 'PLANNER') AND (organization_id IS NULL)) OR ((role = 'ORG_MANAGER') AND (organization_id IS NOT NULL)))` [name: 'app_user_check']
    `role IN ('PLANNER', 'ORG_MANAGER')` [name: 'app_user_role_check']
  }

  Indexes {
    id [pk, name: "app_user_pkey"]
    email [unique, name: "app_user_email_key"]
  }
}

Table "annual_plan" {
  "id" bigint [not null, increment]
  "year" integer [not null]
  "status" "varchar(20) · COLLECTING / CONFIRMED" [not null]
  "confirmed_by" bigint
  "confirmed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 연간 계획을 연 시각']

  Checks {
    `status IN ('COLLECTING', 'CONFIRMED')` [name: 'annual_plan_status_check']
    `((year >= 2000) AND (year <= 9999))` [name: 'annual_plan_year_check']
  }

  Indexes {
    id [pk, name: "annual_plan_pkey"]
    year [unique, name: "annual_plan_year_key"]
  }

  Note: '변경(팀 결정 2026-11-23): contingency_amount 삭제'
}

Table "submission_request" {
  "id" bigint [not null, increment]
  "annual_plan_id" bigint [not null]
  "type" "varchar(30) · ANNUAL_PLAN / MONTHLY_ACTUAL" [not null]
  "month" integer
  "status" "varchar(10) · OPEN / CLOSED" [not null]
  "message" text
  "due_at" timestamptz
  "requested_by" bigint [not null]
  "requested_at" timestamptz [not null]
  "period_key" varchar(30) [not null]

  Checks {
    `(((type = 'ANNUAL_PLAN') AND (month IS NULL)) OR ((type = 'MONTHLY_ACTUAL') AND (month IS NOT NULL)))` [name: 'submission_request_check']
    `((month >= 1) AND (month <= 12))` [name: 'submission_request_month_check']
    `status IN ('OPEN', 'CLOSED')` [name: 'submission_request_status_check']
    `type IN ('ANNUAL_PLAN', 'MONTHLY_ACTUAL')` [name: 'submission_request_type_check']
  }

  Indexes {
    id [pk, name: "submission_request_pkey"]
    period_key [unique, name: "submission_request_period_key_key"]
  }
}

Table "request_target" {
  "request_id" bigint [not null]
  "organization_id" bigint [not null]
  "confirmed_plan_submission_id" bigint
  "excluded" boolean [not null, default: false]
  "selected" boolean [not null, default: true]

  Indexes {
    (request_id, organization_id) [pk, name: "request_target_pkey"]
  }
}

Table "stored_object" {
  "object_key" varchar(100) [not null]
  "content_type" varchar(100) [not null]
  "size_bytes" bigint [not null, note: '추가: 파일 크기']
  "sha256" char(64) [not null, note: '추가: 내용 해시']
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 업로드 시각']

  Note: '변경(아키텍처): 파일 바이트(payload bytea)를 DB에 두지 않고 S3에 저장. object_key = S3 키(uploads/excel/, uploads/pdf/, materials/ prefix)'

  Indexes {
    object_key [pk, name: "stored_object_pkey"]
  }
}

Table "submission" {
  "id" bigint [not null, increment]
  "request_id" bigint [not null]
  "organization_id" bigint [not null]
  "seq" integer
  "status" "varchar(20) · DRAFT / PENDING / REJECTED / APPROVED" [not null]
  "original_filename" varchar(255) [not null]
  "source_object_key" varchar(100) [not null]
  "source_sha256" char(64) [not null]
  "uploaded_by" bigint [not null]
  "uploaded_at" timestamptz [not null]
  "submitted_by" bigint
  "submitted_at" timestamptz
  "reviewed_by" bigint
  "reviewed_at" timestamptz
  "reject_reason" text [note: '경영기획 코멘트. 재제출 요청(REJECTED) 시 필수 (FR-YEAR-003)']
  "previous_submission_id" bigint
  "reply_message" text [note: '추가: 조직 담당자 회신 메시지 (FR-YEAR-003, FR-MONTH-003)']
  "approved_seq" integer [note: '추가: 같은 요청·조직 안의 승인 순번. 버전 표시 ver{월}.{NN} (FR-MONTH-010, FR-ARCH-002). APPROVED일 때만 값']

  Checks {
    `(((status = 'DRAFT') AND (seq IS NULL)) OR ((status <> 'DRAFT') AND (seq IS NOT NULL) AND (seq > 0)))` [name: 'submission_check']
    `status IN ('DRAFT', 'PENDING', 'REJECTED', 'APPROVED')` [name: 'submission_status_check']
    `((status = 'APPROVED') = (approved_seq IS NOT NULL))` [name: 'submission_approved_seq_check']
  }

  Indexes {
    id [pk, name: "submission_pkey"]
    (request_id, organization_id, seq) [unique, name: "submission_request_id_organization_id_seq_key"]
    (request_id, organization_id, approved_seq) [unique, name: "submission_approved_seq_key"]
    (organization_id, uploaded_at, id) [type: btree, name: "ix_submission_org_time"]
  }
}

Table "parsing_job" {
  "id" bigint [not null, increment]
  "submission_id" bigint [not null]
  "status" "varchar(20) · QUEUED / RUNNING / SUCCEEDED / FAILED" [not null, note: '변경: NEEDS_REVIEW 제거(PRD 업로드 흐름은 통과/수정 필요뿐, FR-UPLOAD-005)']
  "engine" varchar(80) [not null]
  "parser_version" varchar(80)
  "contract_version" varchar(80)
  "mapping_version" varchar(80)
  "attempt_no" integer [not null]
  "result_object_key" varchar(100)
  "error_code" varchar(100)
  "error_message" text
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 큐 등록 시각. QUEUED로 오래 남은 작업 재발행 판단(인프라 문서)']
  "started_at" timestamptz
  "finished_at" timestamptz

  Checks {
    `(attempt_no > 0)` [name: 'parsing_job_attempt_no_check']
    `status IN ('QUEUED', 'RUNNING', 'SUCCEEDED', 'FAILED')` [name: 'parsing_job_status_check']
  }

  Indexes {
    id [pk, name: "parsing_job_pkey"]
    submission_id [unique, name: "parsing_job_submission_id_key"]
    (status, id) [type: btree, name: "ix_job_queue"]
  }
}

Table "idempotency_record" {
  "actor_id" bigint [not null]
  "route" varchar(200) [not null]
  "idempotency_key" varchar(128) [not null]
  "fingerprint" char(64) [not null]
  "response_status" integer [not null]
  "response_body" text [not null]
  "location" varchar(200) [not null]
  "expires_at" timestamptz [not null]

  Indexes {
    (actor_id, route, idempotency_key) [pk, name: "idempotency_record_pkey"]
  }
}

Table "account_item" {
  "id" bigint [not null, increment]
  "source_type" "varchar(30) · REVENUE_CLASS / EXPENSE_BUDGET" [not null]
  "source_code" varchar(160) [not null]
  "source_name" varchar(500) [not null]
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 생성 시각. 행이 추가만 되고 수정되지 않아 updated_at은 두지 않음']

  Checks {
    `source_type IN ('REVENUE_CLASS', 'EXPENSE_BUDGET')` [name: 'account_item_source_type_check']
  }

  Indexes {
    id [pk, name: "account_item_pkey"]
    (source_type, source_code, source_name) [unique, name: "account_item_source_type_source_code_source_name_key"]
  }
}

Table "report_item" {
  "id" bigint [not null, increment]
  "code" varchar(160) [not null]
  "name" varchar(500) [not null]
  "parent_id" bigint
  "kind" "varchar(20) · REVENUE / COST / DERIVED" [not null]
  "is_leaf" boolean [not null]
  "calculation_code" varchar(80)
  "display_order" integer [not null, default: 0]
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 생성 시각']
  "updated_at" timestamptz [not null, default: `now()`, note: '추가: 마지막 수정 시각']

  Checks {
    `kind IN ('REVENUE', 'COST', 'DERIVED')` [name: 'report_item_kind_check']
  }

  Indexes {
    id [pk, name: "report_item_pkey"]
    code [unique, name: "report_item_code_key"]
  }
}

Table "financial_line" {
  "id" bigint [not null, increment]
  "submission_id" bigint [not null]
  "account_item_id" bigint
  "report_item_id" bigint [not null]
  "detail_id" varchar(500)
  "detail_revision" varchar(80)
  "headquarters_code" varchar(160)
  "team_code" varchar(160)
  "task_code" varchar(160)
  "management_category" varchar(500)
  "actual_basis" varchar(500)
  "cost_type" varchar(500)
  "description" text
  "headquarters_name" varchar(500)
  "team_name" varchar(500)
  "task_name" varchar(500)
  "person_in_charge" varchar(500)
  "source_sheet" varchar(255) [not null]
  "source_row" integer [not null]

  Checks {
    `(source_row > 0)` [name: 'financial_line_source_row_check']
  }

  Indexes {
    id [pk, name: "financial_line_pkey"]
    (submission_id, source_sheet, source_row) [unique, name: "financial_line_submission_id_source_sheet_source_row_key"]
    (submission_id, report_item_id, id) [type: btree, name: "ix_financial_line_report"]
  }
}

Table "financial_value" {
  "id" bigint [not null, increment]
  "line_id" bigint [not null]
  "year" integer [not null]
  "month" integer [not null]
  "scenario" "varchar(20) · PLAN / ACTUAL / ESTIMATE" [not null]
  "amount" numeric(30,6) [not null]
  "source_record_id" varchar(500) [not null]
  "source_cell" varchar(30) [not null]

  Checks {
    `((month >= 1) AND (month <= 12))` [name: 'financial_value_month_check']
    `scenario IN ('PLAN', 'ACTUAL', 'ESTIMATE')` [name: 'financial_value_scenario_check']
    `((year >= 2000) AND (year <= 9999))` [name: 'financial_value_year_check']
  }

  Indexes {
    id [pk, name: "financial_value_pkey"]
    (line_id, year, month, scenario) [unique, name: "financial_value_line_id_year_month_scenario_key"]
    (year, month, scenario, line_id) [type: btree, name: "ix_financial_value_period"]
  }
}

Table "submission_validation" {
  "submission_id" bigint [not null]
  "attempt_no" integer [not null]
  "source_sha256" char(64) [not null]
  "parser_result_object_key" varchar(100) [not null]
  "policy_version" varchar(80) [not null]
  "validation_result_object_key" varchar(100) [not null]
  "validated_by" bigint [not null]
  "validated_at" timestamptz [not null]

  Checks {
    `(attempt_no > 0)` [name: 'submission_validation_attempt_no_check']
  }

  Indexes {
    submission_id [pk, name: "submission_validation_pkey"]
  }
}

Table "annual_master" {
  "id" bigint [not null, increment]
  "request_id" bigint [not null]
  "seq" integer [not null]
  "previous_master_id" bigint
  "trigger_submission_id" bigint [not null]
  "content_sha256" char(64) [not null]
  "calculation_version" varchar(80) [not null]
  "created_by" bigint [not null]
  "created_at" timestamptz [not null]

  Checks {
    `(seq > 0)` [name: 'annual_master_seq_check']
  }

  Indexes {
    id [pk, name: "annual_master_pkey"]
    (request_id, seq) [unique, name: "annual_master_request_id_seq_key"]
  }
}

Table "annual_master_source" {
  "master_id" bigint [not null]
  "organization_id" bigint [not null]
  "submission_id" bigint [not null]

  Indexes {
    (master_id, organization_id) [pk, name: "annual_master_source_pkey"]
    (master_id, submission_id) [unique, name: "annual_master_source_master_id_submission_id_key"]
    submission_id [type: btree, name: "ix_annual_master_source_submission"]
  }
}

Table "master_version" {
  "id" bigint [not null, increment]
  "request_id" bigint [not null]
  "seq" integer [not null]
  "previous_master_id" bigint
  "trigger_submission_id" bigint [not null]
  "content_sha256" char(64) [not null]
  "calculation_version" varchar(80) [not null]
  "created_by" bigint [not null]
  "created_at" timestamptz [not null]

  Checks {
    `(seq > 0)` [name: 'master_version_seq_check']
  }

  Indexes {
    id [pk, name: "master_version_pkey"]
    (request_id, seq) [unique, name: "master_version_request_id_seq_key"]
  }
}

Table "master_source" {
  "master_id" bigint [not null]
  "organization_id" bigint [not null]
  "submission_id" bigint [not null]

  Indexes {
    (master_id, organization_id) [pk, name: "master_source_pkey"]
    (master_id, submission_id) [unique, name: "master_source_master_id_submission_id_key"]
    submission_id [type: btree, name: "ix_master_source_submission"]
  }
}

Table "gap_threshold" {
  "id" bigint [not null, increment]
  "comparison" "varchar(30) · ACTUAL_VS_PLAN / ESTIMATE_VS_PREVIOUS / ESTIMATE_VS_PLAN" [not null, note: '변경: scenario(ACTUAL/ESTIMATE) → 비교 3종 (FR-MONTH-005 비교 필터)']
  "percent" numeric(30,6) [not null]
  "amount" numeric(30,6) [not null]
  "applied_by" bigint [not null]
  "applied_at" timestamptz [not null]
  "percent_enabled" boolean [not null, default: true]
  "amount_enabled" boolean [not null, default: true]

  Checks {
    `(percent_enabled OR amount_enabled)` [name: 'ck_gap_threshold_enabled']
    `(amount >= 0)` [name: 'gap_threshold_amount_check']
    `(percent >= 0)` [name: 'gap_threshold_percent_check']
    `comparison IN ('ACTUAL_VS_PLAN', 'ESTIMATE_VS_PREVIOUS', 'ESTIMATE_VS_PLAN')` [name: 'gap_threshold_comparison_check']
  }

  Indexes {
    id [pk, name: "gap_threshold_pkey"]
    (comparison, id [desc]) [type: btree, name: "ix_threshold_latest"]
  }
}

Table "review_item" {
  "id" bigint [not null, increment]
  "submission_id" bigint [not null]
  "report_item_id" bigint [not null]
  "year" integer [not null]
  "month" integer [not null]
  "scenario" "varchar(20) · PLAN / ACTUAL / ESTIMATE" [not null]
  "amount_present" boolean [not null]
  "current_amount" numeric(48,6)
  "change_detected" boolean [not null]
  "gap_exceeded" boolean [not null]
  "source_fingerprint" char(64) [not null]
  "context_fingerprint" char(64) [not null]
  "current_round" integer [not null]
  "active" boolean [not null, default: true]
  "review_policy_version" varchar(80) [not null, default: 'legacy/1.0']
  "workflow_state" "varchar(30) · NEEDS_REVIEW / SELECTED / REQUESTED / EXCLUDED" [not null, default: 'NEEDS_REVIEW']
  "workflow_note" varchar(4000)
  "rejected" boolean [not null, default: false, note: '추가: 재제출 요청 때 경영기획팀이 고른 반려 항목 (FR-HIST-004, 조직 화면 6·5-5)']
  "created_at" timestamptz [not null, default: `now()`, note: '추가: 생성 시각']
  "updated_at" timestamptz [not null, default: `now()`, note: '추가: 마지막 수정 시각. 재검증·상태 변경 때 갱신']

  Checks {
    `((amount_present AND (current_amount IS NOT NULL)) OR ((NOT amount_present) AND (current_amount IS NULL)))` [name: 'review_item_check']
    `(current_round > 0)` [name: 'review_item_current_round_check']
    `((month >= 1) AND (month <= 12))` [name: 'review_item_month_check']
    `scenario IN ('PLAN', 'ACTUAL', 'ESTIMATE')` [name: 'review_item_scenario_check']
    `workflow_state IN ('NEEDS_REVIEW', 'SELECTED', 'REQUESTED', 'EXCLUDED')` [name: 'review_item_workflow_state_check']
  }

  Indexes {
    id [pk, name: "review_item_pkey"]
    (submission_id, report_item_id, year, month, scenario) [unique, name: "review_item_submission_id_report_item_id_year_month_scenari_key"]
    (submission_id, active) [type: btree, name: "ix_review_submission_active"]
  }
}

Table "gap_comparison" {
  "id" bigint [not null, increment]
  "review_item_id" bigint [not null]
  "basis" "varchar(20) · PLAN / PREVIOUS" [not null]
  "baseline_submission_id" bigint [not null]
  "baseline_scenario" "varchar(20) · PLAN / ACTUAL / ESTIMATE" [not null]
  "baseline_amount" numeric(48,6) [not null]
  "current_amount" numeric(48,6) [not null]
  "gap_amount" numeric(49,6) [not null]
  "gap_rate" numeric(60,8)
  "threshold_id" bigint [not null]
  "exceeded" boolean [not null]

  Checks {
    `baseline_scenario IN ('PLAN', 'ACTUAL', 'ESTIMATE')` [name: 'gap_comparison_baseline_scenario_check']
    `basis IN ('PLAN', 'PREVIOUS')` [name: 'gap_comparison_basis_check']
  }

  Indexes {
    id [pk, name: "gap_comparison_pkey"]
    (review_item_id, basis) [unique, name: "gap_comparison_review_item_id_basis_key"]
  }
}

Table "review_explanation" {
  "id" bigint [not null, increment]
  "review_item_id" bigint [not null]
  "round" integer [not null]
  "request_note" varchar(4000)
  "requested_by" bigint
  "requested_at" timestamptz
  "answer" varchar(4000)
  "answered_by" bigint
  "answered_at" timestamptz
  "verdict" "varchar(20) · PENDING / ACCEPTED / REJECTED" [not null]
  "reviewed_by" bigint
  "reviewed_at" timestamptz
  "review_note" varchar(4000)
  "inherited_from_id" bigint
  "due_at" timestamptz
  "attachment_revision" bigint [not null, default: 0]

  Checks {
    `(round > 0)` [name: 'review_explanation_round_check']
    `verdict IN ('PENDING', 'ACCEPTED', 'REJECTED')` [name: 'review_explanation_verdict_check']
  }

  Indexes {
    id [pk, name: "review_explanation_pkey"]
    (review_item_id, round) [unique, name: "review_explanation_review_item_id_round_key"]
  }
}

Table "gap_threshold_guard" {
  "id" integer [not null]

  Checks {
    `(id = 1)` [name: 'gap_threshold_guard_id_check']
  }

  Indexes {
    id [pk, name: "gap_threshold_guard_pkey"]
  }
}

Table "review_workflow_event" {
  "id" bigint [not null, increment]
  "review_item_id" bigint [not null]
  "action" "varchar(30) · SELECT / EXCLUDE / REQUEST_EXPLANATION" [not null]
  "explanation_round" integer [not null]
  "note" varchar(4000)
  "due_at" timestamptz
  "acted_by" bigint [not null]
  "acted_at" timestamptz [not null]

  Checks {
    `action IN ('SELECT', 'EXCLUDE', 'REQUEST_EXPLANATION')` [name: 'review_workflow_event_action_check']
  }

  Indexes {
    id [pk, name: "review_workflow_event_pkey"]
    (review_item_id, id) [type: btree, name: "ix_review_workflow_event"]
  }
}

Table "notification" {
  "id" bigint [not null, increment]
  "recipient_id" bigint [not null, note: '받는 경영기획팀 사용자']
  "type" "varchar(20) · SUBMISSION / REPLY / OVERDUE" [not null, note: '조직 제출 / 소명 회신 / 기한 경과 (FR-NOTI-U-001)']
  "event_key" varchar(180) [not null, note: '중복 저장 방지 키 (예: overdue:요청ID:조직ID)']
  "request_id" bigint [not null]
  "organization_id" bigint [not null]
  "submission_id" bigint
  "review_explanation_id" bigint
  "title" varchar(300) [not null]
  "occurred_at" timestamptz [not null, note: '수신 시각. 기한 경과는 기한 시각']
  "read_at" timestamptz [note: 'NULL이면 안 읽음 (FR-NOTI-U-004)']
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `type IN ('SUBMISSION', 'REPLY', 'OVERDUE')` [name: 'notification_type_check']
  }

  Indexes {
    id [pk, name: "notification_pkey"]
    (recipient_id, event_key) [unique, name: "notification_recipient_event_key"]
    (recipient_id, read_at, occurred_at) [type: btree, name: "ix_notification_inbox"]
  }

  Note: '변경(아키텍처): notification_read(읽음만 저장) → notification. 제출·회신은 backend API가 같은 트랜잭션에서, 기한 경과는 @Scheduled 작업이 저장'
}

Table "request_template" {
  "id" bigint [not null, increment]
  "request_id" bigint [not null]
  "object_key" varchar(100) [not null]
  "filename" varchar(255) [not null]
  "source_sha256" char(64) [not null]
  "registered_by" bigint [not null]
  "registered_at" timestamptz [not null]

  Indexes {
    id [pk, name: "request_template_pkey"]
    (request_id, id [desc]) [type: btree, name: "ix_request_template_latest"]
  }
}

Table "review_attachment" {
  "id" bigint [not null, increment]
  "explanation_id" bigint [not null]
  "original_filename" varchar(255) [not null]
  "content_type" varchar(100) [not null]
  "byte_size" bigint [not null]
  "sha256" char(64) [not null]
  "object_key" varchar(100) [not null]
  "uploaded_by" bigint [not null]
  "uploaded_at" timestamptz [not null]

  Checks {
    `((byte_size >= 1) AND (byte_size <= 16777216))` [name: 'review_attachment_byte_size_check']
  }

  Indexes {
    id [pk, name: "review_attachment_pkey"]
    object_key [unique, name: "review_attachment_object_key_key"]
    (explanation_id, id) [type: btree, name: "ix_review_attachment_round"]
  }
}


Table "pdf_job" {
  "id" bigint [not null, increment]
  "requested_by" bigint [not null]
  "source_object_key" varchar(100) [not null, note: 'S3 uploads/pdf/ 원본 PDF']
  "mask_numbers" boolean [not null, default: true, note: 'AI에 보내기 전 숫자 가리기 (FR-RPT-001)']
  "status" "varchar(20) · QUEUED / RUNNING / SUCCEEDED / FAILED" [not null]
  "attempt_no" integer [not null, default: 1]
  "result_object_key" varchar(100) [note: 'S3 materials/ 분석 결과(자료 틀 초안)']
  "error_code" varchar(100)
  "error_message" text
  "created_at" timestamptz [not null, default: `now()`]
  "started_at" timestamptz
  "finished_at" timestamptz

  Checks {
    `status IN ('QUEUED', 'RUNNING', 'SUCCEEDED', 'FAILED')` [name: 'pdf_job_status_check']
    `(attempt_no > 0)` [name: 'pdf_job_attempt_no_check']
  }

  Indexes {
    id [pk, name: "pdf_job_pkey"]
    (status, id) [type: btree, name: "ix_pdf_job_queue"]
  }

  Note: '추가(아키텍처): RabbitMQ pdf.jobs의 상태 기준 테이블. report-ai app은 DB 접속 정보가 없으므로 상태 갱신은 backend 내부 API로 한다'
}

Table "report_template" {
  "id" bigint [not null, increment]
  "name" varchar(200) [not null]
  "created_by" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`, note: '추가: 이름 변경·비활성화 시각']
  "active" boolean [not null, default: true]

  Indexes {
    id [pk, name: "report_template_pkey"]
  }

  Note: '추가: 저장한 자료 틀 = AI 보고서 화면의 \'내 틀\' (FR-RPT-002, 003)'
}

Table "report_template_version" {
  "id" bigint [not null, increment]
  "template_id" bigint [not null]
  "version" integer [not null]
  "source_pdf_job_id" bigint [note: 'PDF 분석으로 만든 경우. 직접 만들면 NULL (FR-RPT-011)']
  "definition" jsonb [not null, note: '블록 구성·기간 규칙·확정 SQL·서식 (FR-RPT-002, 006, 008)']
  "created_by" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(version > 0)` [name: 'report_template_version_version_check']
  }

  Indexes {
    id [pk, name: "report_template_version_pkey"]
    (template_id, version) [unique, name: "report_template_version_key"]
  }

  Note: '추가: 저장할 때마다 새 버전, 이전 버전 유지 (FR-RPT-002). 만든 보고서 결과물은 저장하지 않음'
}

Table "metric" {
  "id" bigint [not null, increment]
  "code" varchar(80) [not null]
  "name" varchar(200) [not null]
  "description" text
  "sql_text" text [not null, note: '검증된 SELECT 문. db-mcp가 보고서용 뷰에만 실행']
  "created_by" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "active" boolean [not null, default: true]

  Indexes {
    id [pk, name: "metric_pkey"]
    code [unique, name: "metric_code_key"]
  }

  Note: '추가: 지표 사전 = 검증된 SQL 모음 (FR-RPT-005). 자주 쓰는 자연어 질의 SQL을 여기로 올림 (FR-RPT-006)'
}

Table "explanation_category" {
  "id" bigint [not null, increment]
  "table_version" integer [not null, note: '분류표 버전 (화면 예: 분류표 v3)']
  "code" integer [not null, note: '1 월정액 추정 Gap / 2 일시적·비경상 / 3 이연 효과 / 4 일시적 효과 / 5 기타']
  "name" varchar(100) [not null]
  "display_order" integer [not null, default: 0]
  "parent_code" integer
  "catch_all" boolean [not null, default: false]
  "suggest_keywords" varchar(500)

  Indexes {
    id [pk, name: "explanation_category_pkey"]
    (table_version, code) [unique, name: "explanation_category_key"]
    table_version [unique, name: "explanation_category_catch_all_key", note: 'catch_all = true 인 행만(부분 유일 인덱스)']
  }

  Note: '추가: 소명 사유 유형 분류표 (FR-RPT-007, AI 보고서 04 소명 분류). 관리 화면(FR-SET-004)은 삭제됐으므로 고정값으로 넣어 둠'
}

Table "explanation_classification" {
  "id" bigint [not null, increment]
  "review_explanation_id" bigint [not null, note: '승인(ACCEPTED)된 소명만']
  "category_id" bigint [not null]
  "classified_by" bigint [not null]
  "classified_at" timestamptz [not null]

  Indexes {
    id [pk, name: "explanation_classification_pkey"]
    review_explanation_id [unique, name: "explanation_classification_key"]
  }

  Note: '추가: 소명별 분류 결과. 같은 조직·항목 소명을 지난달 분류로 미리 채우는 데 씀 (FR-RPT-007)'
}

