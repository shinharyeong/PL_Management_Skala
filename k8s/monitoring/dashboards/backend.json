        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "5xx 비율 (5분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
